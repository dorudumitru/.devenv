{
  // THEME
  "workbench.startupEditor": "none",
  "workbench.settings.editor": "json",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.colorTheme": "Catppuccin Macchiato",
  "workbench.iconTheme": "symbols",
  "window.titleBarStyle": "custom",
  "window.commandCenter": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.tree.indent": 12,
  "catppuccin.accentColor": "rosewater",
  "symbols.hidesExplorerArrows": false,

  // FONT
  "editor.fontFamily": "MonoLisa Variable, JetBrains Mono Medium, JetBrainsMono NF Medium",
  "editor.fontWeight": "500",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.5,
  "editor.fontLigatures": "true",
  "editor.semanticHighlighting.enabled": true,
  "terminal.integrated.fontWeight": "500",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.1,
  "terminal.integrated.minimumContrastRatio": 1,
  // If permission is needed
  // sudo chown -R $(whoami) $(which code) && sudo chown -R $(whoami) /usr/share/code
  // "fonted.font": "JetBrains Mono",
  "fonted.font": "MonoLisa Variable",

  // NVIM SETTINGS
  "vscode-neovim.neovimExecutablePaths.linux": "/usr/local/bin/nvim",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },

  // LANGUAGES
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "go.toolsManagement.autoUpdate": true,
  "go.diagnostic.vulncheck": "Imports",
  // install golangci-lint from https://golangci-lint.run/usage/install for this to work
  "go.lintTool": "golangci-lint-v2",
  "go.lintFlags": ["--path-mode=abs", "--fast-only"],
  "go.formatTool": "custom",
  "go.alternateTools": {
    "customFormatter": "golangci-lint-v2"
  },
  "go.formatFlags": ["fmt", "--stdin"],
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.tabSize": 4,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  "[go.mod]": {
    "editor.defaultFormatter": "golang.go"
  },
  "gopls": {
    "ui.semanticTokens": true
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.tabSize": 4
  },
  "[java]": {
    "editor.defaultFormatter": "josevseb.google-java-format-for-vs-code",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  "[csharp]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "csharpier.csharpier-vscode"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  "typescript.preferences.importModuleSpecifier": "relative",
  "svelte.enable-ts-plugin": true,
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "eslint.validate": ["javascript", "javascriptreact", "svelte", "typescript", "typescriptreact"],
  "prettier.printWidth": 120,

  // MISC
  "editor.tokenColorCustomizations": {
    "[*Light*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#000"
          }
        }
      ]
    },
    "[*Dark*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#fff"
          }
        }
      ]
    },
    "textMateRules": []
  },
  "editor.linkedEditing": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.suggestSelection": "first",
  "editor.tabCompletion": "on", // Regex justify function null @
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorSurroundingLines": 8,
  "editor.lineNumbers": "relative",
  "editor.minimap.enabled": false,
  "editor.inlineSuggest.enabled": true,
  "explorer.autoReveal": false,
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "files.autoSave": "onFocusChange",
  "git.autofetch": true,
  "remote.SSH.showLoginTerminal": true,
  "totalTypeScript.hideAllTips": true,
  "files.associations": {
    ".env*": "dotenv"
  },
  "dotenv.enableAutocloaking": false,
  "breadcrumbs.enabled": false,
  "terminal.integrated.cursorBlinking": true,

  // TELEMETRY
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "gitlens.telemetry.enabled": false,
  "rest-client.enableTelemetry": false,
  "partialDiff.enableTelemetry": false,
  "dotnetAcquisitionExtension.enableTelemetry": false,

  // OTHER
  "applicationRegistrations.useEventualConsistency": false,
  "applicationRegistrations.applicationListView": "Owned Applications",
  "@azure.argTenant": "",
  "makefile.configureOnOpen": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "github.copilot.nextEditSuggestions.enabled": true
}
