#!/usr/bin/env bash

sanity_check() {
  for cmd in tmux fzf fd; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "$cmd is not installed. Please install it first."
      return 1
    fi
  done
}

switch_to() {
  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$1"
  else
    tmux attach-session -t "$1"
  fi
}

sanity_check || return 1 2>/dev/null || exit 1

# --- Directory selection ---
if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(
    fd . ~/Projects \
      -t d \
      --min-depth 1 \
      --max-depth 3 \
      --hidden \
      -E .git \
      -E node_modules \
      -E .next \
      -E dist \
      -E build \
      -E coverage \
      -E .turbo \
      -E .cache \
      -E target \
      -E .venv \
      -E venv \
      -E __pycache__ \
      -E .idea \
      -E .vscode \
      2>/dev/null | fzf
  )
fi

[[ -z "$selected" ]] && return 0 2>/dev/null || exit 0

# --- Safer session name ---
selected_name=$(basename "$selected" | tr -cs '[:alnum:]' '_')

# --- Create session if needed ---
if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

switch_to "$selected_name"

