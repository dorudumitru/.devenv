#!/usr/bin/env bash

pararser() {
  # Define default values
  name=${name:-""}
  path=${path:-""}

  # Assign the values given by the user
  while [ $# -gt 0 ]; do
    if [[ $1 == "--help" ]]; then
      echo " Usage:"
      echo "   --name         project name (required | ex: myapp)"
      echo "   --path         project path (optional | ex: ~/Projects/work | default: ~/Projects/personal)"
      exit
    elif [[ $1 == *"--"* ]]; then
      param="${1/--/}"
      declare -g "$param"="$2"
    fi
    shift
  done

}

pararser "$@"

projectPath=$path/$name
makefilePath=~/Documents/Go/Makefile

if [[ $name == "" ]]; then
  echo "param --name is required"
  exit
fi

if [[ $path == "" ]]; then
  projectPath=~/Projects/personal/$name
fi

mkdir -p "$projectPath"
cp $makefilePath "$projectPath"
tmux-sessionizer "$projectPath"
