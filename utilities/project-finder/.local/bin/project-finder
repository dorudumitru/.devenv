#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(
    fd . ~/Projects \
      --type d \
      --min-depth 1 \
      --max-depth 3 \
      --hidden \
      --exclude .git \
      --exclude node_modules \
      --exclude .next \
      --exclude dist \
      --exclude build \
      --exclude coverage \
      --exclude .turbo \
      --exclude .cache \
      --exclude target \
      --exclude .venv \
      --exclude venv \
      --exclude __pycache__ \
      --exclude .idea \
      --exclude .vscode \
      2>/dev/null | fzf
  )
fi

[[ -z $selected ]] && return
cd "$selected" || return

